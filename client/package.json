{
  "name": "soonchunhyang-wordpress-theme",
  "version": "2.0.0",
  "description": "Theme giao diện WordPress Tailwind CSS cho Đại học Soonchunhyang Việt Nam",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
